[Unit]
Description=gunicorn daemon
After=network.target
[Service]
User=ВАШ_ЮЗЕР
Group=www-data
WorkingDirectory=/project/backend_cloude_storage
Environment=DJANGO_SETTINGS_MODULE=cloude_storage.settings
Environment=PYTHONUNBUFFERED=1
ExecStart=/project/backend_cloude_storage/env/bin/gunicorn \
          --access-logfile - \
          --workers 1 \
          --bind 127.0.0.1:8000 \
          cloude_storage.wsgi:application

[Install]
WantedBy=multi-user.target

