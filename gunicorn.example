[Unit]
Description=gunicorn daemon
After=network.target
[Service]
User=root
Group=www-data
WorkingDirectory=/home/artem/cloude_storage/backend_cloude_storage
Environment=DJANGO_SETTINGS_MODULE=cloude_storage.settings
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/artem/cloude_storage/env/bin/gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/home/artem/cloude_storage/backend_cloude_storage/cloude_storage/project.sock \
          cloude_storage.wsgi:application

[Install]
WantedBy=multi-user.target
