server {
    listen 443 ssl;
    server_name адрес_сервера;

    ssl_certificate /etc/ssl/certs/django.crt;
    ssl_certificate_key /etc/ssl/private/django.key;

    # Параметры безопасности
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;

        location = /admin/ {
        proxy_pass http://127.0.0.1:8000/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
}


        location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_method $request_method;
        proxy_pass_request_headers on;

        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' 'http://ваш_айпи' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        # Для работы с куками между поддоменами/путями
        proxy_cookie_path / "/; secure; HttpOnly; SameSite=None";
    }
   
    location / {
        root /project/backend_cloude_storage/static;
        try_files $uri $uri/ /index.html;


    }
}

server {
    listen 80;
    server_name ваш_айпи;
    return 301 https://$server_name$request_uri;
}


